        "task": "transcribe",
        "force_selected_source_language": true,
        "weight_download_gb_approx": 3.08,
        "source_urls": [
          "https://huggingface.co/mlx-community/whisper-large-v3-mlx",
          "https://github.com/openai/whisper",
          "https://raw.githubusercontent.com/openai/whisper/main/whisper/tokenizer.py"
        ]
      },
      "translation": {
        "backend": "mlx-lm",
        "model": "mlx-community/translategemma-12b-it-4bit",
        "message_schema": "translategemma",
        "weight_download_gb_approx": 6.62,
        "source_urls": [
          "https://huggingface.co/mlx-community/translategemma-12b-it-4bit",
          "https://huggingface.co/google/translategemma-12b-it",
          "https://arxiv.org/pdf/2601.09012"
