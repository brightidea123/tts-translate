{
  "schema_version": 1,
  "verified_on": "2026-11-07",
  "hardware_target": "Apple M4 Max, 48 GB unified memory, native ARM64 Python 3.12",
  "language_order": ["ar", "he", "de", "tr", "fr", "ru"],
  "default_profile": "baseline",
  "notes": [
    "These are model-selection recommendations; application code must explicitly load/apply this file to activate them.",
    "Reported weight sizes are download sizes, not peak unified memory measurements.",
    "No M4 Max latency or accuracy benchmark was performed to select these profiles.",
    "Use one shared model instance per worker, not a separate model per language; retain utterance/revision ordering in the caller.",
